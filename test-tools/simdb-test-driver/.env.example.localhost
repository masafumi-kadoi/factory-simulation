# localhost 用設定例（スタンドアロンモード）
# 使い方: cp .env.example.localhost .env

# Docker Compose プロファイル: simdb-postgres を起動する
COMPOSE_PROFILES=standalone

# PostgreSQL 公開ポート（ホスト側）
SIMDB_PG_PORT=5433

# ドライバー API 公開ポート
SIMDB_DRIVER_PORT=8099

# DB 接続情報
SIMDB_DB_NAME=simdb_test
SIMDB_DB_USER=simdb
SIMDB_DB_PASSWORD=simdb

# 再生速度倍率（初期値）
SIMDB_SPEED=1.0

# 動作モード (standalone / central)
SIMDB_TARGET_MODE=standalone
