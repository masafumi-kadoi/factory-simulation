# 中央 DB 統合モード用設定例
# 使い方: cp .env.example.central .env
#
# このモードでは simdb-postgres は起動しません。
# factory-simulation の factory_simulation DB に直接 INSERT します。

# ドライバー API 公開ポート
SIMDB_DRIVER_PORT=8099

# 接続先: factory_simulation 中央 DB
# Mac / Windows (Docker Desktop) の場合
SIMDB_DB_HOST=host.docker.internal
# Linux (docker0 ブリッジ) の場合は以下をコメントアウトして使用
# SIMDB_DB_HOST=172.17.0.1

SIMDB_DB_PORT=5432
SIMDB_DB_NAME=factory_simulation
SIMDB_DB_USER=postgres
SIMDB_DB_PASSWORD=postgres

# 再生速度倍率（初期値）
SIMDB_SPEED=1.0

# 動作モード
SIMDB_TARGET_MODE=central

# Gateway URL (data_source_id の自動発行に使用)
# Mac / Windows の場合
SIMDB_GATEWAY_URL=http://host.docker.internal:8080
# Linux の場合
# SIMDB_GATEWAY_URL=http://172.17.0.1:8080

# data_source_id を手動で指定する場合（GATEWAY_URL の代わり）
# あらかじめ GET /api/data-sources 等で取得した UUID を設定する
# SIMDB_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# タイムスタンプ正規化 (central モードのデフォルト: true)
# true にすると INSERT 時の event_time を wall clock に置き換える
# （ビジュアライザーが現在時刻のデータとして表示するために必要）
# SIMDB_NORMALIZE_TIMESTAMPS=false
